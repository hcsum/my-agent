{
  "$schema": "https://opencode.ai/config.json",
  "share": "manual",
  "snapshot": false,
  "provider": {
    "openai": {
      "models": {
        "gpt-5.5": {
          "options": { "reasoningEffort": "medium" }
        }
      }
    }
  },
  "instructions": [
    "notes/user.md",
    "~/.mentor/plugin/stance.md",
    "~/.mentor/profile.md"
  ],
  "skills": { "paths": ["~/.mentor/plugin/skills"] },
  "plugin": ["./plugin/scheduler.ts", "./plugin/send-file.ts"],
  "permission": {
    "external_directory": "allow"
  }
}
