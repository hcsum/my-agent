{
  "name": "opencode-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenCode workspace with skills, notes, and email bridge",
  "scripts": {
    "bridge": "bash scripts/bridge.sh",
    "cf:agent-status:check": "wrangler deploy --dry-run --config cloudflare/agent-status-worker/wrangler.jsonc",
    "cf:agent-status:deploy": "wrangler deploy --config cloudflare/agent-status-worker/wrangler.jsonc",
    "cf:agent-status:dev": "wrangler dev --config cloudflare/agent-status-worker/wrangler.jsonc",
    "cf:agent-status:types": "wrangler types cloudflare/agent-status-worker/worker-configuration.d.ts --config cloudflare/agent-status-worker/wrangler.jsonc",
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "format:backlink-master": "node scripts/csv-to-md-table.mjs notes/projects/backlink-master.csv notes/projects/backlink-master.md",
    "format:md": "prettier --write \"**/*.md\"",
    "format:md:check": "prettier --check \"**/*.md\"",
    "notes:bootstrap": "bash scripts/bootstrap-notes.sh",
    "notes:update": "bash scripts/update-notes.sh",
    "notes:backup": "bash scripts/save-notes.sh",
    "mentor:seed": "bash scripts/seed-mentor-tasks.sh",
    "opencode:login:openai": "opencode auth login -p openai",
    "start": "node dist/index.js",
    "opencode": "bash scripts/opencode-local.sh",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "validate-ingest": "tsx src/validate-ingest.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.207",
    "@opencode-ai/sdk": "^1.14.20",
    "better-sqlite3": "^12.9.0",
    "dotenv": "^16.6.1",
    "imapflow": "^1.4.7",
    "mailparser": "^3.9.14",
    "nodemailer": "^9.0.3",
    "playwright-core": "^1.54.1",
    "undici": "^7.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.15.21",
    "@types/nodemailer": "^8.0.1",
    "prettier": "^3.9.1",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "wrangler": "^4.106.0"
  },
  "engines": {
    "node": ">=22"
  }
}
